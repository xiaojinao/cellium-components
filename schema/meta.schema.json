{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cellium component metadata",
  "type": "object",
  "required": [
    "slug",
    "name",
    "summary",
    "category",
    "author",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "enum": [
        "web",
        "ai",
        "security",
        "interaction",
        "automation",
        "data",
        "media",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "repo": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "deprecated": {
      "type": "boolean"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "changelog": {
            "type": "string",
            "maxLength": 500
          },
          "file": {
            "type": "string",
            "readOnly": true,
            "description": "由构建生成：Git 模式打包后的 zip 文件名；直链模式不使用"
          },
          "download": {
            "type": "string",
            "pattern": "^https://",
            "description": "直链模式：安装包 zip 的 https 直链（如 GitHub Release 附件）。填了此字段则构建不拉源码、不打包，只做可达性校验"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "description": "安装包字节数，可选，构建时从响应头自动回填"
          },
          "min_agent": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "description": "git 模式：tag 或分支名（给人看）"
          },
          "commit": {
            "type": "string",
            "description": "git 模式：锁定的 commit SHA（推荐，优先于 ref）"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "description": "组件源码所在的 Git 仓库；索引仓库内不放任何组件源码，未配置 download 直链时必须提供",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "git"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "subdir": {
          "type": "string",
          "description": "组件目录在仓库中的路径，留空表示仓库根目录"
        }
      }
    }
  }
}
